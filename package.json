{
  "name": "remote-sessions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/client"
  ],
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "npm run dev --workspace @remote-sessions/client",
    "build": "npm run build --workspace @remote-sessions/client",
    "typecheck": "npm run typecheck --workspace @remote-sessions/client",
    "test": "npm run test --workspace @remote-sessions/client",
    "tauri": "npm run tauri --workspace @remote-sessions/client --",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run check:docs"
  },
  "devDependencies": {
    "@xterm/headless": "6.0.0"
  }
}
